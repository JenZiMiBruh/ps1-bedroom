<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">
    <ImageView
        android:id="@+id/control_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_window_label" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PS1 BEDROOM"
            android:textColor="#FF77EE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
        <TextView
            android:id="@+id/control_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="Tap play to start your room"
            android:textColor="#D6DDFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/control_sleep"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_button_bg"
        android:src="@drawable/ic_sleep"
        android:contentDescription="Sleep in 30 minutes" />
    <ImageButton
        android:id="@+id/control_play"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_play_bg"
        android:src="@drawable/ic_play"
        android:contentDescription="Play or pause" />
</LinearLayout>