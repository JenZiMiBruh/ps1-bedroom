<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_window_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ww_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="The view out of your window" />

    <LinearLayout
        android:id="@+id/ww_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ww_light_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="💡"
            android:textSize="13sp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Toggle the ceiling light" />

        <TextView
            android:id="@+id/ww_tv_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="📺"
            android:textSize="13sp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Toggle the TV" />

        <TextView
            android:id="@+id/ww_sound_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="🔊"
            android:textSize="13sp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Toggle room sound" />

        <TextView
            android:id="@+id/ww_weather_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="🌦"
            android:textSize="13sp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Next weather" />

        <TextView
            android:id="@+id/ww_blinds_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="🪟"
            android:textColor="#FFE8E4FF"
            android:textSize="13sp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Cycle window blinds" />

        <TextView
            android:id="@+id/ww_place_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="🗺️"
            android:textColor="#FFE8E4FF"
            android:textSize="13sp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Next place outside" />

        <TextView
            android:id="@+id/ww_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFE8E4FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Refresh window snapshot" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ww_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="22dp"
        android:paddingBottom="10dp"
        android:background="@drawable/widget_window_shade">

        <TextClock
            android:id="@+id/ww_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1" />

        <TextClock
            android:id="@+id/ww_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, d MMMM"
            android:textColor="#FFE8E4FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1" />

        <TextView
            android:id="@+id/ww_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="☀️ 72°F Clear  ·  🌆 Downtown"
            android:textColor="#FFFFD27D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1" />
    </LinearLayout>
</FrameLayout>
